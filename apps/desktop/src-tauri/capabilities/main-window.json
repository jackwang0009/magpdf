{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "主窗口能做的事：收主进程转发的引擎事件，调用应用自己的命令（三个文档类的、崩溃恢复的两个、取瓦片走共享缓冲区的三个）。别的 Tauri 接口一概不开。",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-engine-request",
    "allow-open-document-dialog",
    "allow-save-document-as",
    "allow-acknowledge-close-request",
    "allow-confirm-exit",
    "allow-open-documents",
    "allow-recoverable-documents",
    "allow-recover-documents",
    "allow-tile-transport",
    "allow-attach-tile-buffers",
    "allow-fetch-tile-shared"
  ]
}
