# Rust
/target/
**/target/

# Tauri 构建时在源码目录里生成的文件：权限表的 JSON Schema、应用命令的权限定义
/apps/desktop/src-tauri/gen/
/apps/desktop/src-tauri/permissions/autogenerated/

# Node
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo

# PDFium 预编译库：由 scripts/fetch-pdfium-prebuilt.ps1 拉取，不入库
/third_party/pdfium-prebuilt/

# 模型文件与 ONNX Runtime：由 models/fetch-models.ps1 按 manifest.json 下载，不入库
/models/**/*.onnx
/models/**/*.tar
/models/**/*.zip
/models/ocr/
/models/onnxruntime/

# Python（测试文件库工具）
__pycache__/
*.pyc

# 测试输出
/tests/out/
# V08 样本生成与评测脚本的输出（改后的 PDF、结果 JSON、超过 1 MB 的完整嵌入样本）
/out/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# V09 合成 OCR 样本输出（gen_synthetic.py 生成，不入库）
/tests/corpus/synthetic-ocr/out/
# V12 临时性能测量脚本与截图（本地运行，不入库）
/.perf/
# 本机调试脚本、截图等临时产物统一放这里，不入库
/_agent_tmp/
