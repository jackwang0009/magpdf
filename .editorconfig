root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 只有在带 BOM 时才按 UTF-8 读取脚本里的中文
[*.ps1]
charset = utf-8-bom

[Makefile]
indent_style = tab
